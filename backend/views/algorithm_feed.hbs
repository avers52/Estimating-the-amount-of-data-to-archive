<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Лента алгоритмов сжатия</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="feed-container">
        <!-- Название по центру сверху -->
        <div class="feed-header-top">
          <div class="feed-title-center">{{algorithm.algorithm_name}}</div>
        </div>

        <!-- Видео со статики или дефолтное (Требование 22) -->
        <video class="feed-video" autoplay loop muted playsinline>
          {{#if algorithm.video_url}}
            <source src="{{algorithm.video_url}}" type="video/mp4">
          {{else}}
            <source src="/zstd_benchmark.mp4" type="video/mp4">
          {{/if}}
        </video>

        <!-- Вертикальная колонка параметров справа -->
        <div class="feed-right-column">
          <div class="feed-action-pill">
            <span class="icon">⚡</span>
            <span>x{{algorithm.compression_ratio}}</span>
          </div>

          <div class="feed-action-pill">
            <span class="icon">🚀</span>
            <span>{{algorithm.compression_speed_mbps}}M</span>
          </div>

          <div class="feed-action-pill">
            <span class="icon">❤️</span>
            <span>{{algorithm.likes_count}}</span>
          </div>

          <a href="/compression-algorithms/feed?algorithm_id={{algorithm.nextId}}" class="feed-action-pill btn-next">
            <span class="icon">➜</span>
            <span>След.</span>
          </a>
        </div>

        <!-- Описание снизу: 2 строки + кнопка "Еще" -->
        <div class="feed-bottom-panel">
          <div id="feedDescription" class="feed-clamped-desc">
            {{algorithm.algorithm_description}}
          </div>
          <button id="btnReadMore" class="btn-read-more" onclick="toggleDescription()">Еще</button>
        </div>
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link active">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link">Плитка</a>
    </nav>
  </div>

  <script>
    function toggleDescription() {
      const desc = document.getElementById('feedDescription');
      const btn = document.getElementById('btnReadMore');
      if (desc.classList.contains('expanded')) {
        desc.classList.remove('expanded');
        btn.textContent = 'Еще';
      } else {
        desc.classList.add('expanded');
        btn.textContent = 'Скрыть';
      }
    }
  </script>
</body>
</html>
