<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Лента алгоритмов сжатия</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="feed-container">
        <video class="feed-video" autoplay loop muted playsinline>
          <source src="{{algorithm.video_url}}" type="video/mp4">
        </video>

        <!-- Название алгоритма сверху по центру -->
        <div class="feed-top-bar">
          <div class="feed-title-center">{{algorithm.algorithm_name}}</div>
        </div>

        <!-- Правая колонка с коэффициентом, метриками и действиями -->
        <div class="feed-right-actions">
          <div class="side-item">
            <span class="side-badge-ratio">x{{algorithm.compression_ratio}}</span>
            <span class="side-label">Сжатие</span>
          </div>
          <div class="side-item">
            <span class="side-icon">⚡</span>
            <span class="side-label">{{algorithm.compression_speed_mbps}}M</span>
          </div>
          <div class="side-item">
            <span class="side-icon">💾</span>
            <span class="side-label">{{algorithm.ram_usage_mb}}M</span>
          </div>
          <div class="side-item">
            <span class="side-icon">❤️</span>
            <span class="side-label">{{algorithm.likes_count}}</span>
          </div>
          <a href="/compression-algorithms/feed?algorithm_id={{algorithm.algorithm_id}}&next=true" class="side-next-btn">
            ➔
          </a>
        </div>

        <!-- Нижний блок: ровно 2 строки описания и кнопка переключения -->
        <div class="feed-bottom-info">
          <div class="feed-desc-short" id="feedDesc">
            {{algorithm.algorithm_description}}
          </div>
          <button type="button" class="btn-more" id="moreBtn" onclick="toggleDesc()">Еще</button>
        </div>
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link active">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link">Плитка</a>
    </nav>
  </div>

  <script>
    function toggleDesc() {
      const el = document.getElementById('feedDesc');
      const btn = document.getElementById('moreBtn');
      const isExpanded = el.classList.toggle('expanded');
      btn.innerText = isExpanded ? 'Скрыть' : 'Еще';
    }
  </script>
</body>
</html>
