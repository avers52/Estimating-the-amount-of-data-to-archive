<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Параметры алгоритма</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="draft-container">
        <div class="section-header">Параметры алгоритма</div>
        
        {{#if draftAlgorithm}}
          <div class="section-subtitle">Шаг 2: Публикация алгоритма</div>

          <form method="POST" action="/compression-algorithms/draft/publish" class="publish-form" autocomplete="off">
            <!-- Медиафайлы остаются сверху -->
            <div class="form-card">
              <div class="form-card-title">ВЫБРАННЫЕ МЕДИАФАЙЛЫ</div>

              <!-- Видео -->
              <div class="media-field-group">
                <div class="media-sub-label">Видео</div>
                <div class="media-preview-box">
                  <video autoplay loop muted playsinline>
                    <source src="{{#if draftAlgorithm.video_url}}{{draftAlgorithm.video_url}}{{else}}/gzip_process.mp4{{/if}}" type="video/mp4">
                  </video>
                </div>
                <input type="hidden" name="video_url" value="{{#if draftAlgorithm.video_url}}{{draftAlgorithm.video_url}}{{else}}/gzip_process.mp4{{/if}}">
              </div>

              <!-- Фото -->
              <div class="media-field-group" style="margin-top: 10px;">
                <div class="media-sub-label">Фото карточки</div>
                <div class="media-preview-box">
                  <img src="{{#if draftAlgorithm.image_url}}{{draftAlgorithm.image_url}}{{else}}/gzip_draft.png{{/if}}" alt="Превью фото">
                </div>
                <input type="hidden" name="image_url" value="{{#if draftAlgorithm.image_url}}{{draftAlgorithm.image_url}}{{else}}/gzip_draft.png{{/if}}">
              </div>
            </div>

            <!-- Поля параметров: НАЗВАНИЕ ПОЯВЛЯЕТСЯ ЗДЕСЬ -->
            <div class="form-card">
              <div class="form-card-title">НАЗВАНИЕ И ПАРАМЕТРЫ</div>
              
              <!-- Поле ввода названия алгоритма появилось после «Далее» -->
              <div class="media-sub-label">Название алгоритма</div>
              <input class="input-field" type="text" name="algorithm_name" autocomplete="off" required>

              <div class="media-sub-label" style="margin-top: 6px;">Коэффициент сжатия</div>
              <input class="input-field" type="number" step="0.01" name="compression_ratio" autocomplete="off" required>
              
              <div class="media-sub-label" style="margin-top: 6px;">Скорость сжатия (МБ/с)</div>
              <input class="input-field" type="number" step="1" name="compression_speed_mbps" autocomplete="off" required>
              
              <div class="media-sub-label" style="margin-top: 6px;">Описание</div>
              <textarea class="input-field" name="algorithm_description" rows="3" autocomplete="off" required></textarea>
              
              <button type="submit" class="btn-primary" style="margin-top: 8px;">Опубликовать</button>
            </div>
          </form>

        {{else}}
          <div class="section-subtitle">Шаг 1: Создание черновика</div>

          <!-- На Шаге 1 только выбор видео и фото, без названия -->
          <form method="POST" action="/compression-algorithms/draft/create" class="form-card" autocomplete="off">
            
            <!-- 1. Выбор видео сверху -->
            <div class="media-field-group">
              <div class="media-sub-label">Видео</div>
              <div class="media-preview-box">
                <video id="step1VideoPreview" autoplay loop muted playsinline>
                  <source id="videoSourcePreview" src="/gzip_process.mp4" type="video/mp4">
                </video>
              </div>
              <label class="btn-choose-file">
                Выбрать файл видео
                <input type="file" accept="video/*" style="display: none;" onchange="handleStep1Video(event)">
              </label>
              <input type="hidden" name="video_url" id="step1VideoInput" value="/gzip_process.mp4">
            </div>

            <!-- 2. Выбор фото под видео -->
            <div class="media-field-group" style="margin-top: 12px;">
              <div class="media-sub-label">Фото карточки</div>
              <div class="media-preview-box">
                <img id="step1ImagePreview" src="/gzip_draft.png" alt="Превью фото">
              </div>
              <label class="btn-choose-file">
                Выбрать файл фото
                <input type="file" accept="image/*" style="display: none;" onchange="handleStep1Image(event)">
              </label>
              <input type="hidden" name="image_url" id="step1ImageInput" value="/gzip_draft.png">
            </div>

            <!-- Кнопка «Далее» сразу после выбора медиа -->
            <button type="submit" class="btn-primary" style="margin-top: 14px;">Далее</button>
          </form>
        {{/if}}
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link active">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link">Плитка</a>
    </nav>
  </div>

  <script>
    const MINIO_BASE = 'http://localhost:9000/compression-algorithms-media/';

    function handleStep1Video(event) {
      const file = event.target.files[0];
      if (file) {
        const video = document.getElementById('step1VideoPreview');
        const source = document.getElementById('videoSourcePreview');
        source.src = URL.createObjectURL(file);
        video.load();
        video.play();
        document.getElementById('step1VideoInput').value = MINIO_BASE + file.name;
      }
    }

    function handleStep1Image(event) {
      const file = event.target.files[0];
      if (file) {
        const img = document.getElementById('step1ImagePreview');
        img.src = URL.createObjectURL(file);
        document.getElementById('step1ImageInput').value = MINIO_BASE + file.name;
      }
    }
  </script>
</body>
</html>
