<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Черновик алгоритма</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="draft-container">
        <div class="section-header">Параметры алгоритма</div>
        <div class="section-subtitle">Черновой профиль (DRAFT)</div>

        <!-- Медиафайлы: Видео сверху, Фото под видео -->
        <div class="form-card">
          <div class="form-card-title">Медиафайлы</div>
          
          <div class="vertical-media-stack">
            <!-- 1. Сверху ВИДЕО -->
            <div class="preview-tile">
              <div class="preview-header">Видео</div>
              <div class="media-thumb">
                <video id="vidDisplay" src="{{draftAlgorithm.video_url}}" muted playsinline autoplay loop></video>
              </div>
              <label class="file-choose-label">
                Выбрать видео
                <input type="file" accept="video/*" class="file-input-hidden">
              </label>
            </div>

            <!-- 2. Снизу ФОТО -->
            <div class="preview-tile">
              <div class="preview-header">Фото</div>
              <div class="media-thumb">
                <img id="imgDisplay" src="{{draftAlgorithm.image_url}}" alt="Превью фото">
              </div>
              <label class="file-choose-label">
                Выбрать фото
                <input type="file" accept="image/*" class="file-input-hidden">
              </label>
            </div>
          </div>
        </div>

        <div class="form-card">
          <div class="form-card-title">Параметры сжатия</div>
          <input class="input-field" type="text" value="{{draftAlgorithm.algorithm_name}}" placeholder="Название">
          <input class="input-field" type="number" step="0.1" value="{{draftAlgorithm.compression_ratio}}" placeholder="Коэффициент">
          <input class="input-field" type="number" value="{{draftAlgorithm.compression_speed_mbps}}" placeholder="Скорость (МБ/с)">
          <input class="input-field" type="number" value="{{draftAlgorithm.ram_usage_mb}}" placeholder="RAM (МБ)">
          <textarea class="input-field" rows="3" placeholder="Описание">{{draftAlgorithm.algorithm_description}}</textarea>
        </div>
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link active">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link">Плитка</a>
    </nav>
  </div>
</body>
</html>