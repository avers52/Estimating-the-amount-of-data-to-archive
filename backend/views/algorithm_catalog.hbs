<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Каталог алгоритмов</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="catalog-container">
        <div class="section-header">Каталог алгоритмов</div>
        <div class="section-subtitle">Выбор алгоритма архивации</div>

        <!-- Поиск через Range Slider со счетчиком -->
        <form method="GET" action="/compression-algorithms/catalog" class="filter-slider-box">
          <div class="slider-group">
            <div class="slider-label-row">
              <span>Сжатие от:</span>
              <span id="sliderValueDisplay">x{{#if filterValue}}{{filterValue}}{{else}}1.0{{/if}}</span>
            </div>
            <input 
              type="range" 
              name="min_compression_ratio" 
              class="filter-range" 
              min="1.0" 
              max="6.0" 
              step="0.1" 
              value="{{#if filterValue}}{{filterValue}}{{else}}1.0{{/if}}"
              oninput="document.getElementById('sliderValueDisplay').textContent = 'x' + parseFloat(this.value).toFixed(1)"
            >
          </div>
          <button type="submit" class="btn-filter-apply">Найти</button>
        </form>

        <div class="catalog-grid">
          {{#each algorithmsList}}
          <div class="algorithm-card">
            <a href="/compression-algorithms/feed?algorithm_id={{this.algorithm_id}}" style="text-decoration:none; color:inherit;">
              <div class="card-image-wrap">
                <!-- Заглушка по умолчанию для фото (Требование 22) -->
                {{#if this.image_url}}
                  <img src="{{this.image_url}}" alt="{{this.algorithm_name}}">
                {{else}}
                  <img src="/gzip_draft.png" alt="Default Algorithm">
                {{/if}}
              </div>
              <div class="card-content">
                <div class="card-name">{{this.algorithm_name}}</div>
                <div class="card-ratio">Сжатие: x{{this.compression_ratio}}</div>
                <div class="card-likes">❤️ {{this.likes_count}}</div>
              </div>
            </a>
            <div style="padding: 0 10px 10px;">
              <form method="POST" action="/compression-algorithms/catalog/delete/{{this.algorithm_id}}">
                <button type="submit" class="btn-card-delete">Удалить</button>
              </form>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link active">Плитка</a>
    </nav>
  </div>
</body>
</html>
