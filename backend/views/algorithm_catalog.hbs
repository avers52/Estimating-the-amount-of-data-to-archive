<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Каталог алгоритмов</title>
  <link rel="stylesheet" href="/css/compression_styles.css">
</head>
<body>
  <div class="mobile-frame">
    <div class="content-area">
      <div class="catalog-container">
        <div class="section-header">Каталог алгоритмов</div>
        <div class="section-subtitle">Выбор алгоритма архивации</div>

        <form method="GET" action="/compression-algorithms/catalog" class="filter-row">
          <input 
            type="number" 
            step="any" 
            name="min_compression_ratio" 
            class="filter-input" 
            placeholder="Коэффициент сжатия (напр. 2 или 3.8)" 
            value="{{filterValue}}"
          >
          <button type="submit" class="filter-btn">Найти</button>
        </form>

        <div class="catalog-grid">
          {{#each algorithms}}
            <div class="algorithm-card">
              <h3>{{this.name}}</h3>
              <p>{{this.description}}</p>
              <div>Коэффициент: x{{this.compression_ratio}}</div>
              <div>Скорость: {{this.compression_speed_mbps}} МБ/с</div>
              <div>Лайков: {{this.likes_count}}</div>

              <!-- Кнопка удаления услуги через чистый SQL UPDATE -->
              <form method="POST" action="/compression-algorithms/catalog/delete/{{this.id}}">
                <button type="submit" class="delete-btn">Удалить</button>
              </form>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    <nav class="tab-navigation">
      <a href="/compression-algorithms/feed" class="tab-link">Лента</a>
      <a href="/compression-algorithms/draft" class="tab-link">Черновик</a>
      <a href="/compression-algorithms/catalog" class="tab-link active">Плитка</a>
    </nav>
  </div>
</body>
</html>